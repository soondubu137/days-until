    "The clocks skip this time. Choose another." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時計の切り替えでこの時刻はありません。別の時刻を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계 조정으로 이 시간은 건너뜁니다. 다른 시간을 선택하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
